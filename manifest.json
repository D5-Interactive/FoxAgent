{
  "manifest_version": 3,
  "name": "FoxAgent",
  "version": "0.3.0",
  "description": "A browser agent in the Firefox sidebar. Reads pages, drives the UI, and runs tasks with local model servers or your own cloud API keys.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxagent@d5interactive.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/fox-16.png",
    "32": "icons/fox-32.png",
    "48": "icons/fox-48.png",
    "96": "icons/fox-96.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/background/main.js"
    ],
    "type": "module",
    "persistent": false
  },
  "sidebar_action": {
    "default_title": "FoxAgent",
    "default_panel": "src/sidebar/sidebar.html",
    "default_icon": {
      "48": "icons/fox-48.png"
    },
    "open_at_install": true
  },
  "action": {
    "default_title": "Open FoxAgent sidebar",
    "default_icon": {
      "48": "icons/fox-48.png"
    }
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Open the FoxAgent sidebar"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src *; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'"
  }
}
